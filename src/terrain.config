# =============================================================================
# TERRAIN CONFIGURATION
# =============================================================================
# Movement cost formula (cardinal):     cost = destination base cost
# Movement cost formula (diagonal):     cost = (a/2) + (b/2 × √b)
#   where a = origin cost, b = destination cost
# Combination formula:                  cost = a + (b + c)
#   where a = modifier cost, b = base terrain cost, c = tuning constant
# All costs rounded to nearest integer
# Die: d8
# =============================================================================

[constants]
combination_tuning_c = -1.8
die = 10

# =============================================================================
# BASE TERRAINS
# =============================================================================

[terrain.plain]
cost = 1
combinable = false

[terrain.grassland]
cost = 1
combinable = false

[terrain.forest]
cost = 2
combinable = false

[terrain.thick_forest]
cost = 2.5
combinable = false

[terrain.jungle]
cost = 3
combinable = false

[terrain.marsh]
cost = 2.5
combinable = false

[terrain.desert]
cost = 2
combinable = false

[terrain.deep_desert]
cost = 3
combinable = false

[terrain.tundra]
cost = 3
combinable = false

[terrain.frozen_tundra]
cost = 3.5
combinable = false

# =============================================================================
# COASTAL TYPES (standalone, not combinable)
# =============================================================================

[terrain.river]
cost = 2
combinable = false

[terrain.coastal]
cost = 1
combinable = false

[terrain.floodplain]
cost = 1.5
combinable = false

[terrain.cliff_coast]
cost = 3
combinable = false

# =============================================================================
# DOMINANT TERRAINS (base terrain for combinations)
# formula: modifier_cost + (dominant_cost + c)
# =============================================================================

[dominant.hills]
cost = 3.25
valid_modifiers = plain, grassland, forest, thick_forest, desert, deep_desert, tundra, frozen_tundra

[dominant.mountain]
cost = 5
valid_modifiers = plain, grassland, forest, thick_forest, desert, deep_desert, tundra, frozen_tundra

# =============================================================================
# COMBINATION COSTS  (a + (b + c), c = -1)
# =============================================================================

# Hills combinations  (a + 3)
[combination.hills]
plain           = 4     # 1 + 3
grassland       = 4     # 1 + 3
forest          = 5     # 2 + 3
thick_forest    = 6     # 3 + 3
desert          = 5     # 2 + 3
deep_desert     = 6     # 3 + 3
tundra          = 6     # 3 + 3
frozen_tundra   = 7     # 4 + 3

# Mountain combinations  (a + 4)
[combination.mountain]
plain           = 5     # 1 + 4  (= base mountain, no effective change)
grassland       = 5     # 1 + 4  (= base mountain, no effective change)
forest          = 6     # 2 + 4
thick_forest    = 7     # 3 + 4
desert          = 6     # 2 + 4
deep_desert     = 7     # 3 + 4
tundra          = 7     # 3 + 4
frozen_tundra   = 8     # 4 + 4  (= d8 ceiling, effectively impassable)

# =============================================================================
# INVALID COMBINATIONS
# =============================================================================

[invalid_combinations]
# Geographically nonsensical pairings — not permitted in terrain generation
marsh + hills       = invalid   # marsh is low-lying, hills contradict this
marsh + mountain    = invalid
floodplain + hills  = invalid
floodplain + mountain = invalid

# =============================================================================
# MAP GENERATION
# =============================================================================
# Full pipeline:
#   1. Perlin noise → elevation heightmap
#   2. Threshold → ocean + coastal variants (cliff where steep, floodplain where gentle)
#   3. River extraction → trace high→low elevation to ocean, imprint as tile modifiers
#   4. Elevation demoted → retained as bias scalar only, not deterministic
#   5. Seed placement → k × √(N×M) seeds, terrain via latitude + elevation + world settings
#   6. Seed expansion → each seed populates its 8 neighbours
#   7. While loop expansion → inverse distance weighted, radius capped at max_expansion_radius
#   8. Isolated tile fallback → force assign any tiles with no assigned neighbours
# =============================================================================

[map.size]
default_width   = 60
default_height  = 40
large_width     = 80
large_height    = 50
# Add more presets as needed

[map.generation]
seed_formula            = int(k * sqrt(N * M))  # sublinear scaling
seed_k_default          = 1.0                   # ~2% on 60x40
seed_k_min              = 0.5                   # "Continental" — few seeds, large coherent biomes
seed_k_max              = 2.0                   # "Fragmented"  — many seeds, chaotic patchwork
max_expansion_radius    = 3                     # influence radius cap regardless of round count
# Inverse distance weighting: d=1 → 1.0, d=2 → 0.5, d=3 → 0.33

[map.river]
movement_penalty        = 1                     # added to tile base cost for movement only
development_options     = bridge, mill, port, irrigation
# Base cost retained for development/value calculations

# =============================================================================
# WORLD SETTINGS
# =============================================================================
# These dials scale the adjacency weight vectors during terrain generation.
# Each setting shifts biome probability distributions without hardcoding outcomes.
# =============================================================================

[world.climate]
# Applied as multipliers to adjacency matrix rows, then renormalize column to 100
# cold  → boosts cold terrains, suppresses hot terrains
# hot   → boosts hot terrains, suppresses cold terrains
# x0.1 floor preserved on all terrains — no hard zeros, just extreme rarity
default = temperate
options = cold, temperate, hot

#                        Cold    Temperate   Hot
tundra          =       1.5,    1.0,        0.3
frozen_tundra   =       1.5,    1.0,        0.1
desert          =       0.5,    1.0,        1.5
deep_desert     =       0.3,    1.0,        1.5
jungle          =       0.1,    1.0,        1.5
forest          =       1.2,    1.0,        0.8
grassland       =       1.0,    1.0,        1.2
plain           =       1.2,    1.0,        1.0
# Unlisted terrains use multiplier of 1.0 (no climate effect)

[world.precipitation]
# Applied as multipliers to adjacency matrix rows, then renormalize column to 100
# wet   → boosts wet terrains, suppresses dry terrains
# arid  → boosts dry terrains, suppresses wet terrains
# +-50% for strongly wet/dry terrains, +-20% for moderate terrains
default = normal
options = arid, normal, wet

#                        Arid    Normal  Wet
marsh           =       0.5,    1.0,    1.5
floodplain      =       0.5,    1.0,    1.5
jungle          =       0.5,    1.0,    1.5
forest          =       0.8,    1.0,    1.2
grassland       =       0.8,    1.0,    1.2
desert          =       1.5,    1.0,    0.5
deep_desert     =       1.5,    1.0,    0.5
plain           =       1.2,    1.0,    0.8
# Unlisted terrains use multiplier of 1.0 (no precipitation effect)

[world.age]
# Modifies hill_range upper bounds directly
# young → rugged, more mountains and hills
# old   → eroded, flatter terrain, mountains worn to hills
default = old
options = young, old
hill_range_delta_young  =  0.15    # added to all upper bounds (except marsh, floodplain, coastal, cliff_coast, mountain)
hill_range_delta_old    = -0.10    # subtracted from all upper bounds
# Age also influences hills scalar weights (TBD during prototyping):
# young → higher beta (Perlin/slope dominates)
# old   → higher gamma (neighbour smoothing dominates)

[world.fragmentation]
# Maps to seed_k — exposed as named preset rather than raw number
default = default
options = continental, default, fragmented
continental = 0.5
fragmented  = 2.0

[world.presets]
# Named presets combining all dials
low_countries   = climate:temperate, precipitation:wet, age:old, fragmentation:default
# ^ Default preset — nod to the historical Dutch/Flemish inspiration

# =============================================================================
# STARTING POSITIONS
# =============================================================================

[starting_positions]
mode            = dispersed     # dispersed (default) or convergent
min_distance    = 15            # minimum tiles between players (dispersed only)
quality_radius  = 3             # radius for scoring candidate tiles
randomness      = 0.2           # 0.0 = always best tile, 1.0 = fully random

# Dispersed: map divided into player-count zones, best scoring tile selected per zone
#   scoring factors: terrain variety, developable land, not ocean/river/mountain/thick_forest
# Convergent: single central tile, decent terrain, near coast or river if possible
# Invalid starting terrains: ocean, river, mountain, thick_forest, cliff_coast

# =============================================================================
# HILLS SCALAR SYSTEM
# =============================================================================
# Hills scalar: continuous value 0.0 → 1.0 representing terrain ruggedness
#
# Bands:
#   0.0  → hills_flat_threshold      : Flat — no hills modifier applied
#   hills_flat_threshold → hills_mountain_threshold : Hills modifier applied
#   hills_mountain_threshold → 1.0   : Mountain (standalone if base_cost ≤ 1,
#                                       combined if base_cost > 1)
#
# Per-tile scalar formula:
#   Seed tiles:      hills = α × sample(terrain.hill_range) + β × normalized_sobel(elevation)
#   Expansion tiles: hills = α × sample(terrain.hill_range) + β × normalized_sobel(elevation)
#                          + γ × weighted_avg(neighbour_hills_scalars, 1/distance)
#
# Sobel operator applied to Perlin elevation heightmap measures local slope/ruggedness
# =============================================================================

[hills.thresholds]
hills_flat_threshold        = 0.20      # below this → flat, no modifier
hills_mountain_threshold    = 0.75      # at or above this → mountain

[hills.weights]
alpha   = 0.4       # terrain character weight
beta    = 0.4       # perlin elevation/sobel slope weight
gamma   = 0.2       # neighbour influence weight
# alpha + beta + gamma should sum to 1.0

[hills.ranges]
# Base hill scalar range per terrain type (lower_bound, upper_bound)
# Sampled uniformly: int(lower*100, upper*100) / 100
# Before Perlin and neighbour influence
#
# Terrain              Lower   Upper
plain           =       0.00,   0.25
grassland       =       0.00,   0.35
forest          =       0.05,   0.45
thick_forest    =       0.05,   0.50
jungle          =       0.00,   0.40
marsh           =       0.00,   0.05
desert          =       0.05,   0.50
deep_desert     =       0.00,   0.35
tundra          =       0.05,   0.55
frozen_tundra   =       0.05,   0.60
coastal         =       0.00,   0.10
floodplain      =       0.00,   0.05
cliff_coast     =       0.10,   0.50
mountain        =       0.75,   1.00

# =============================================================================
# TERRAIN + ELEVATION VALIDITY MATRIX
# =============================================================================
# Determines valid combinations of base terrain × elevation class
# 1 = valid combination, 0 = invalid (blocked regardless of scalar value)
# Elevation classes: flat (< hills_flat_threshold),
#                    hills (hills_flat_threshold → hills_mountain_threshold),
#                    mountain (>= hills_mountain_threshold)
#
# Two independent systems (terrain matrix + hills scalar) are overlaid at render time
# Invalid combinations are re-rolled or clamped to nearest valid elevation class
# No "combined terrain" is ever directly sampled — combinations are emergent
# =============================================================================

[validity_matrix]
# Terrain          Flat    Hills   Mountain
plain           =   1,      1,      0
grassland       =   1,      1,      0
forest          =   1,      1,      1
thick_forest    =   1,      1,      1
jungle          =   1,      1,      1
marsh           =   1,      0,      0
desert          =   1,      1,      1
deep_desert     =   1,      1,      1
tundra          =   1,      1,      1
frozen_tundra   =   1,      1,      1
coastal         =   1,      0,      0
floodplain      =   1,      0,      0
cliff_coast     =   1,      1,      0
mountain        =   0,      0,      1

# =============================================================================
# ADJACENCY MATRIX
# =============================================================================
# Read COLUMN-WISE: given I am terrain X (column), probability of each neighbour (row)
# All columns sum to 100
# These are BASE probabilities only — runtime context filters zero out impossible
# entries (e.g. coastal inland, tundra at equator) and renormalize to 100
#
# Asymmetric by design — "plain looking out" differs from "coastal looking out"
# Row summation has no meaning, do not use row-wise
#
# Columns: Plain, Grassland, Forest, Thick Forest, Jungle, Marsh, Desert,
#          Deep Desert, Tundra, Frozen Tundra, Coastal, Floodplain, Cliff Coast, Mountain
# =============================================================================

[adjacency_matrix]
#                        Pln  Grs  For  ThF  Jun  Mar  Des  DeD  Tun  FrT  Cst  Fld  Clf  Mnt
Plain           =         23,  18,  12,   7,   2,   4,  11,   3,   8,   7,   8,   6,  12,   8
Grassland       =         18,  21,  15,   8,   2,   7,   4,   2,   3,   2,   7,   5,  10,   8
Forest          =         12,  17,  21,  20,   6,  10,   2,   0,   5,   3,   3,   2,   4,   8
Thick_Forest    =          7,   8,  20,  15,   8,  10,   0,   0,   4,   2,   1,   6,   2,   8
Jungle          =          2,   2,   5,   8,  15,  12,   3,   0,   0,   0,   8,  13,   8,   8
Marsh           =          4,   6,   7,  10,  12,  22,   0,   0,   1,   1,  12,  14,   0,   8
Desert          =          7,   4,   1,   0,   3,   0,  21,  19,   0,   0,   6,   8,   6,   8
Deep_Desert     =          3,   2,   0,   0,   0,   0,  18,  35,   0,   0,   4,   4,   7,   8
Tundra          =          3,   3,   4,   4,   0,   1,   0,   0,  30,  33,   5,   2,   5,   8
Frozen_Tundra   =          2,   2,   3,   2,   0,   1,   0,   0,  25,  28,   4,   4,   3,   8
Coastal         =          9,   8,   4,   5,  22,  12,   8,   8,   7,   4,  18,  14,  18,   5
Floodplain      =          6,   5,   2,   8,  19,  20,   8,   4,   2,   4,  17,  17,   4,   2
Cliff_Coast     =          1,   1,   2,   2,   3,   0,   6,   7,   5,   3,   5,   2,  12,   4
Mountain        =          3,   3,   4,  11,   8,   1,  19,  22,  10,  12,   2,   3,   9,   9
#                        ---  ---  ---  ---  ---  ---  ---  ---  ---  ---  ---  ---  ---  ---
# Column Total  =        100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100

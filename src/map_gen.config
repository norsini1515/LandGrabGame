# =============================================================================
# MAP GENERATION PARAMETERS
# =============================================================================
# Tuneable generation constants separate from terrain rules.
# Edit here to change map shape, ocean coverage, river density, etc.
# =============================================================================

[noise]
# OpenSimplex octave parameters
scale       = 0.06      # base frequency multiplier
octaves     = 6         # number of stacked noise octaves
persistence = 0.5       # amplitude decay per octave  (0–1)
lacunarity  = 2.0       # frequency growth per octave (>1)

[ocean]
# Elevation (0–1) thresholds for water tile classification
elevation_threshold  = 0.30     # below this  → ocean
coastal_threshold    = 0.40     # ocean < elev < this AND adjacent to ocean → coastal
cliff_min_gradient   = 0.015    # elevation gradient above this → cliff_coast
floodplain_max_gradient = 0.005 # elevation gradient below this → floodplain (near ocean)

[edge_fade]
# Continental continent shape — suppresses elevation at map edges
start_ratio = 0.60      # fade begins at this fraction from center (e.g. 0.6 = 60% of radius)

[rivers]
count_divisor = 350     # num_rivers = max(1, W*H // count_divisor)
min_descent   = 0.005   # minimum elevation drop required to continue river trace

[spawn]
# Starting position selection
quality_radius     = 3                              # radius of tiles scored around candidate
preferred_terrains = plain, grassland, coastal      # highest quality starting biomes
invalid_terrains   = ocean, river, cliff_coast, thick_forest  # never spawn here

[seed_expansion]
# BFS expansion behaviour
max_fallback_attempts = 50   # attempts to place each seed on a valid tile
